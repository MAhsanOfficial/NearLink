DATABASE_URL=postgresql+asyncpg://nearlink_user:nearlink_pass@localhost:5432/nearlink
GEMINI_API_KEY=your_gemini_api_key_here
JWT_SECRET=your_jwt_secret_here_change_in_production
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
ADMIN_EMAIL=admin@nearlink.com
ADMIN_PASSWORD=123

# --- Agentic orchestrator ---
# "llm" (Gemini decides which tool to call next; deterministic policy takes over on failure) or "policy" (always deterministic)
ORCHESTRATOR_MODE=llm
# Seconds to wait for live Google Places / OSM / geocoding before continuing with what we have
LIVE_SEARCH_TIMEOUT_S=8
# In-process follow-up scheduler (reminders). Set to "off" on serverless hosts and call POST /api/followup/tick from a cron instead.
FOLLOWUP_SCHEDULER=on
# If set, POST /api/followup/tick requires header X-Cron-Secret
CRON_SECRET=
# "off" disables the demo-only endpoint that lets a customer simulate "the provider cancels"
DEMO_MODE=on

# --- WhatsApp (Twilio) - optional; the in-app simulator needs none of this ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public URL Twilio calls (used to verify X-Twilio-Signature), e.g. https://api.example.com
PUBLIC_BASE_URL=
